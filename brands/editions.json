[
  {
    "id": "off-the-clock-creative-suite",
    "name": "Off the Clock Creative Suite",
    "tagline": "Private creative and file tools that run in your browser.",
    "themeKey": "offtheclock-theme",
    "logo": null,
    "css": null
  },
  {
    "id": "studiolo",
    "name": "Studiolo",
    "tagline": "Private file tools that run in your browser.",
    "themeKey": "studiolo-theme",
    "logo": "brands/studiolo/logo.svg",
    "css": [
      "brands/studiolo/brand.css",
      "brands/studiolo/license.css"
    ],
    "navLinks": [
      {
        "href": "about.html",
        "label": "About",
        "homeLabel": "About Studiolo \u2192"
      }
    ],
    "extraFiles": {
      "about.html": "brands/studiolo/about.html",
      "css/about.css": "brands/studiolo/about.css",
      "js/about.js": "brands/studiolo/about.js",
      "icons/studiolo.png": "brands/studiolo/app-icon-512.png",
      "icons/studiolo.ico": "brands/studiolo/Studiolo.ico"
    },
    "favicon": "icons/studiolo.png",
    "package": {
      "folder": "resources",
      "rootFiles": {
        "Studiolo.html": "brands/studiolo/launcher.html",
        "Read Me.txt": "brands/studiolo/Read Me.txt",
        "Add Studiolo to Desktop.cmd": "brands/studiolo/Add Studiolo to Desktop.cmd"
      }
    },
    "headHtml": "<script src=\"js/core.js\"></script>",
    "bundle": {
      "output": "js/core.js",
      "parts": [
        "brands/studiolo/nacl-fast.min.js",
        "@license-data",
        "brands/studiolo/license.js"
      ]
    },
    "rename": {
      "StudioloLicense": "__sx",
      "STUDIOLO_LICENSE_DATA": "__sxd",
      "studiolo-license": "sx.p",
      "license-": "sx-",
      ".hashes": ".q",
      "data.batches": "data.bb",
      "b.salt": "b.x"
    },
    "exclude": [
      "README.md"
    ],
    "activation": "brands/studiolo/activation.json"
  }
]
